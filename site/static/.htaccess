# Hébergement OVH (Apache). {{base}} est remplacé au build par chemin_web de config/ovh.json.

Options -Indexes
AddDefaultCharset utf-8

<IfModule mod_rewrite.c>
  RewriteEngine On
  # HTTPS partout
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # la racine envoie vers la langue du navigateur (anglais sauf si le français est demandé)
  RewriteCond %{HTTP:Accept-Language} ^fr [NC]
  RewriteRule ^$ {{base}}fr/ [L,R=302]
  RewriteRule ^$ {{base}}en/ [L,R=302]
  # adresse courte d'un effet : /fx/42 ou /fx/0042 ouvre sa page (/fr/fx/42/), dans la langue du navigateur
  RewriteCond %{HTTP:Accept-Language} ^fr [NC]
  RewriteRule ^fx/0*(\d+)/?$ {{base}}fr/fx/$1/ [L,R=302]
  RewriteRule ^fx/0*(\d+)/?$ {{base}}en/fx/$1/ [L,R=302]
</IfModule>

# fichiers cachés (.git, .env…) et données de l'API jamais servis
RedirectMatch 404 /\.(?!htaccess$)
RedirectMatch 404 ^{{base}}api/donnees/

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
